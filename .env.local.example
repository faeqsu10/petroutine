# Firebase Client (공개 키 - 클라이언트에서 사용)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
# 로컬은 localhost 또는 배포 앱 도메인, Firebase Hosting helper는 next.config rewrites로 프록시
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app-domain.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Firebase Admin (서버 전용 - 비공개)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----"

# Kakao Login (카카오 로그인)
NEXT_PUBLIC_KAKAO_JS_KEY=your_kakao_javascript_key           # JavaScript 키 (SDK용)
NEXT_PUBLIC_KAKAO_REST_API_KEY=your_kakao_rest_api_key       # REST API 키 (OAuth 리다이렉트용)
KAKAO_REST_API_KEY=your_kakao_rest_api_key                   # REST API 키 (서버 콜백용)

# Admin Access (운영 화면 접근 제어)
ADMIN_EMAILS=admin@example.com
ADMIN_UIDS=admin-uid
